// Mono microphone samples delivered on the caller's main CFRunLoop. No work
// here runs on an audio worker: callbacks and reads share one thread.
Alloc, AllocError, Ptr, null_ptr = std.mem
callback = std.native

str = std.text
class, selector, text = macos.objc

Permission* = NotDetermined | Restricted | Denied | Authorized | Unavailable

Authorization = c.bind("objc/message.h", "objc_msgSend", {
    status* = (receiver: Ptr<()>, selector: Ptr<()>, media: Ptr<()>) i64
})

// Read-only: checking status never presents a permission dialog.
permission* = (a: Alloc) Res<Permission, AllocError> {
    device = class(a, "AVCaptureDevice").try();
    device.is_null().match({
        true  => Ok(Permission.Unavailable),
        false => {
            value = Authorization.status(
                device,
                selector(a, "authorizationStatusForMediaType:").try(),
                text(a, "soun").try()
            );
            Ok(value.match({
                0 => Permission.NotDetermined,
                1 => Permission.Restricted,
                2 => Permission.Denied,
                3 => Permission.Authorized,
                _ => Permission.Unavailable,
            }))
        },
    })
}

permission_text* = (value: Permission) str {
    value.match({
        NotDetermined => "Microphone permission not reported — press F2 to start",
        Restricted    => "Microphone restricted by system policy",
        Denied        => "Microphone denied — enable in System Settings > Privacy & Security > Microphone",
        Authorized    => "Microphone authorized",
        Unavailable   => "Microphone authorization unavailable",
    })
}

// Capture evidence is separate from the OS authorization result. Some launch
// contexts report NotDetermined while AudioQueue delivers non-silent input.
// Never relabel that result as Authorized or hide Denied/Restricted.
capture_permission_text* = (value: Permission, received_audio: bool) str {
    value.match({
        NotDetermined => received_audio.match({
            true  => "Microphone audio received",
            false => permission_text(value),
        }),
        Unavailable   => received_audio.match({
            true  => "Microphone audio received",
            false => permission_text(value),
        }),
        _             => permission_text(value),
    })
}

SAMPLE_COUNT*: usize = 1024
SAMPLE_RATE*: f64 = 16000.0
RECORDING_CAPACITY*: usize = 480000
// Continuous capture cannot keep up with its consumer; audio was not retained.
CAPTURE_OVERFLOW*: i32 = -70001
CAPTURE_ALLOCATION_FAILED*: i32 = -70002

// A bounded view of the captured prefix, available during capture or after
// stop. On the main thread, existing prefix samples stay unchanged until the
// next start attempt or discard_prefix; new audio extends a later view's count.
// Copy or serialize on the main thread before sending work to another thread.
// The allocator must outlive every view.
Recording* = { data*: Ptr<f32>, count*: usize, rate*: u32 }

// CoreAudio's AudioStreamBasicDescription ABI on Apple silicon.
Format = {
    rate: f64,
    format: u32,
    flags: u32,
    bytes_per_packet: u32,
    frames_per_packet: u32,
    bytes_per_frame: u32,
    channels: u32,
    bits: u32,
    reserved: u32,
}

// Prefix of AudioQueueBuffer; only these fields are inspected.
Buffer = { capacity: u32, data: Ptr<f32>, size: u32 }

RunLoop = c.bind("CoreFoundation/CoreFoundation.h", {
    CFRunLoopGetCurrent* = () Ptr<()>
})
NewInput = c.bind("AudioToolbox/AudioToolbox.h", "AudioQueueNewInput", {
    create* = (format: Ptr<Format>, callback: Ptr<()>, user: Ptr<()>, loop: Ptr<()>, mode: Ptr<()>, flags: u32, output: Ptr<Ptr<()>>) i32
})
AllocateBuffer = c.bind("AudioToolbox/AudioToolbox.h", "AudioQueueAllocateBuffer", {
    allocate* = (queue: Ptr<()>, size: u32, output: Ptr<Ptr<()>>) i32
})
Queue = c.bind("AudioToolbox/AudioToolbox.h", {
    AudioQueueEnqueueBuffer* = (queue: Ptr<()>, buffer: Ptr<()>, packets: u32, descriptions: Ptr<()>) i32
    AudioQueueStart* = (queue: Ptr<()>, time: Ptr<()>) i32
    AudioQueueStop* = (queue: Ptr<()>, immediate: bool) i32
    AudioQueueDispose* = (queue: Ptr<()>, immediate: bool) i32
})

// Native callback lifetime can exceed the caller's arena when disposal fails.
// This pointer-sized token is detached before stopping; only successful disposal
// proves no future callback can read it and permits release. NewInput explicitly
// targets the creating main CFRunLoop; callback and detach are serialized there.
// The token is deliberately non-atomic: cross-thread Capture use is unsupported.
CallbackMemory = c.bind("stdlib.h", {
    malloc* = (size: usize) Ptr<()>
    free* = (memory: Ptr<()>) ()
})

State = {
    data: Ptr<f64>,
    recording: Ptr<f32>,
    recorded :: usize,
    generation :: usize,
    session :: usize,
    next :: usize,
    count :: usize,
    error :: i32,
    running :: bool,
    received_audio :: bool,
    continuous :: bool,

    append = (self :: @Self, incoming: Ptr<f32>, count: usize) {
        Range(0, count).loop((i) {
            (self.error == 0).then(() {
                (self.continuous && self.recorded >= RECORDING_CAPACITY).match({
                    true  => { self.error = CAPTURE_OVERFLOW; },
                    false => {
                        sample = incoming.read(i);
                        (sample > 0.0 || sample < 0.0).then(
                            () { self.received_audio = true; }
                        );
                        self.data.write(self.next, sample.to_f64());
                        (self.recorded < RECORDING_CAPACITY).then(() {
                            self.recording.write(self.recorded, sample);
                            self.recorded = self.recorded + 1;
                        });
                        self.next = (self.next + 1) % SAMPLE_COUNT;
                        (self.count < SAMPLE_COUNT).then(
                            () { self.count = self.count + 1; }
                        );
                    },
                });
            });
        });
    }
}

input_callback = (
    user         : Ptr<()>,
    queue        : Ptr<()>,
    incoming     : Ptr<()>,
    timestamp    : Ptr<()>,
    packets      : u32,
    descriptions : Ptr<()>
) {
    state_ptr = user.to<Ptr<State>>().read(0);
    (!state_ptr.is_null()).then(() {
        state ::= state_ptr.read(0);
        state.running.then(() {
            buffer = incoming.to<Buffer>().read(0);
            bytes  = (buffer.size <= buffer.capacity).match({true => buffer.size, false => buffer.capacity});
            count  = bytes.to_usize() / 4;
            state.append(buffer.data, count);
            (state.error == 0).then(() {
                state.error = Queue.AudioQueueEnqueueBuffer(
                    queue,
                    incoming,
                    0,
                    null_ptr<()>()
                );
            });
            state_ptr.write(0, state);
        });
    });
}

// The allocator owns sample state and must outlive the call to stop(), even if
// stop reports failure. Failed disposal retains only an inert native token and
// queue; a later stop retries cleanup. All methods must be
// called on the same main thread as create/start. Do not copy a live Capture.
Capture* = {
    state: Ptr<State>,
    format: Ptr<Format>,
    queue: Ptr<Ptr<()>>,
    buffer: Ptr<Ptr<()>>,
    context: Ptr<Ptr<()>>,

    create* = (a: Alloc) Res<Capture, AllocError> {
        data      = a.realloc<f64>(null_ptr<f64>(), SAMPLE_COUNT).try();
        recording = a.realloc<f32>(null_ptr<f32>(), RECORDING_CAPACITY).try();
        state     = a.realloc<State>(null_ptr<State>(), 1).try();
        format    = a.realloc<Format>(null_ptr<Format>(), 1).try();
        queue     = a.realloc<Ptr<()>>(null_ptr<Ptr<()>>(), 1).try();
        buffer    = a.realloc<Ptr<()>>(null_ptr<Ptr<()>>(), 1).try();
        context   = a.realloc<Ptr<()>>(null_ptr<Ptr<()>>(), 1).try();
        context.write(0, null_ptr<()>());
        state.write(
            0,
            State(
                data: data,
                recording: recording,
                recorded: 0,
                generation: 0,
                session: 0,
                next: 0,
                count: 0,
                error: 0,
                running: false,
                continuous: false,
                received_audio: false
            )
        );
        format.write(
            0,
            Format(
                rate: SAMPLE_RATE,
                format: 1819304813,
                flags: 9,
                bytes_per_packet: 4,
                frames_per_packet: 1,
                bytes_per_frame: 4,
                channels: 1,
                bits: 32,
                reserved: 0
            )
        );
        queue.write(0, null_ptr<()>());
        buffer.write(0, null_ptr<()>());
        Ok(Capture(
            state: state,
            format: format,
            queue: queue,
            buffer: buffer,
            context: context
        ))
    }

    // Nonzero samples observed during this capture session, not an OS grant.
    received_audio* = (self: @Self) bool { self.state.read(0).received_audio }

    // Choose before start; mode changes while a queue is live are rejected.
    continuous* = (self: @Self, enabled: bool) bool {
        state ::= self.state.read(0);
        (self.queue.read(0).is_null() && !state.running).match({
            true  => {
                state.continuous = enabled;
                self.state.write(0, state);
                true
            },
            false => false,
        })
    }

    // Main-thread consumption after copying/submitting audio elsewhere. This
    // invalidates previous recording views but leaves the session and FFT ring.
    discard_prefix* = (self: @Self, count: usize) bool {
        state ::= self.state.read(0);
        (count <= state.recorded).match({
            true  => {
                remaining = state.recorded - count;
                Range(0, remaining).loop((i) {
                    state.recording.write(i, state.recording.read(count + i));
                });
                state.recorded = remaining;
                self.state.write(0, state);
                true
            },
            false => false,
        })
    }

    // Call only after an explicit microphone action. macOS controls the access
    // prompt; the app bundle must supply NSMicrophoneUsageDescription.
    start* = (self: @Self) i32 {
        self.queue.read(0).is_null().match({
            false => self.status(),
            true  => {
                state ::= self.state.read(0);
                state.session        = state.session + 1;
                state.received_audio = false;
                state.recorded       = 0;
                state.next           = 0;
                state.count          = 0;
                state.error          = 0;
                state.running        = false;
                self.state.write(0, state);
                token = CallbackMemory.malloc(null_ptr<Ptr<State>>().bytes(1));
                self.context.write(0, token);
                status ::= CAPTURE_ALLOCATION_FAILED;
                (!token.is_null()).then(() {
                    token.to<Ptr<State>>().write(0, self.state);
                    status = NewInput.create(
                        self.format,
                        callback(input_callback),
                        token,
                        RunLoop.CFRunLoopGetCurrent(),
                        null_ptr<()>(),
                        0,
                        self.queue
                    );
                });
                (status == 0).then(() {
                    queue = self.queue.read(0);
                    Range(0, 3).loop((i) {
                        (status == 0).then(() {
                            status = AllocateBuffer.allocate(
                                queue,
                                1024,
                                self.buffer
                            );
                            (status == 0).then(() {
                                status = Queue.AudioQueueEnqueueBuffer(
                                    queue,
                                    self.buffer.read(0),
                                    0,
                                    null_ptr<()>()
                                );
                            });
                        });
                    });
                    (status == 0).then(() {
                        state.running = true;
                        self.state.write(0, state);
                        status = Queue.AudioQueueStart(queue, null_ptr<()>());
                    });
                });
                (status != 0).then(() {
                    self.stop();
                    failed ::= self.state.read(0);
                    failed.error = status;
                    self.state.write(0, failed);
                });
                status
            },
        })
    }

    stop* = (self: @Self) i32 {
        state ::= self.state.read(0);
        state.running.then(() { state.generation = state.generation + 1; });
        state.running = false;
        self.state.write(0, state);
        token = self.context.read(0);
        (!token.is_null()).then(() {
            token.to<Ptr<State>>().write(0, null_ptr<State>());
        });
        queue = self.queue.read(0);
        queue.is_null().match({
            true  => {
                CallbackMemory.free(token);
                self.context.write(0, null_ptr<()>());
                0
            },
            false => {
                stopped  = Queue.AudioQueueStop(queue, true);
                disposed = Queue.AudioQueueDispose(queue, true);
                (disposed == 0).match({
                    true  => {
                        self.queue.write(0, null_ptr<()>());
                        CallbackMemory.free(token);
                        self.context.write(0, null_ptr<()>());
                    },
                    false => {
                        failed ::= self.state.read(0);
                        failed.error = disposed;
                        self.state.write(0, failed);
                    },
                });
                (disposed == 0).match({true => stopped, false => disposed})
            },
        })
    }

    // Call each UI frame. Disposal stays outside the audio callback, and the
    // generation counter advances so the completed recording can be consumed.
    poll* = (self: @Self) i32 {
        state = self.state.read(0);
        (state.running && ((!state.continuous && state.recorded >= RECORDING_CAPACITY) || state.error != 0)).match({
            true  => {
                stopped = self.stop();
                (state.error != 0).match({true => state.error, false => stopped})
            },
            false => state.error,
        })
    }

    // A failed dispose keeps the queue and inert callback token for retry.
    // Sample arena release is safe after stop returns, regardless of this value.
    // A permanently failed disposal leaks native resources until process exit.
    closed* = (self: @Self) bool { self.queue.read(0).is_null() }

    recording* = (self: @Self) Recording {
        state = self.state.read(0);
        Recording(data: state.recording, count: state.recorded, rate: 16000)
    }

    // Changes when a new start attempt resets the captured prefix, including
    // a failed attempt. An idempotent start while already active keeps its ID.
    // Tag transcription jobs with this value and discard older-session replies.
    session* = (self: @Self) usize { self.state.read(0).session }

    generation* = (self: @Self) usize { self.state.read(0).generation }

    active* = (self: @Self) bool { self.state.read(0).running }
    status* = (self: @Self) i32 { self.state.read(0).error }

    // Destination must hold 1024 f64 samples. Leading silence pads startup.
    samples* = (self: @Self, destination: Ptr<f64>) usize {
        state   = self.state.read(0);
        padding = SAMPLE_COUNT - state.count;
        Range(0, padding).loop((i) { destination.write(i, 0.0); });
        first = (state.next + SAMPLE_COUNT - state.count) % SAMPLE_COUNT;
        Range(0, state.count).loop((i) {
            destination.write(
                padding + i,
                state.data.read((first + i) % SAMPLE_COUNT)
            );
        });
        state.count
    }
}
