replace = macos.file
main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();
    path     = env.argv.get(1).match({Ok(v) => v, None => ""});
    bytes    = env.argv.get(2).match({Ok(v) => v, None => ""});
    existing = env.argv.get(3).match({Ok(v) => v.eq("existing"), None => false});
    Ok(replace(a, path, bytes, existing).match({Ok(_) => 0, Err(_) => 1}))
}
